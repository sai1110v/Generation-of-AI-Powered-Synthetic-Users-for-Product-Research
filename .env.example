# Database (SQLite by default — free, zero setup)
DATABASE_URL=sqlite:///./app.db

# LLM: groq (cloud free tier) | ollama (local) | gemini (free tier)
# Groq removes the need to keep Ollama or your laptop running.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional local fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Gemini fallback
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host binding (0.0.0.0 for network / tunnel access)
HOST=0.0.0.0
PORT=8000
